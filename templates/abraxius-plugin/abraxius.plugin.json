{
  "schemaVersion": 1,
  "id": "com.example.plugin",
  "version": "1.0.0",
  "name": "Example Plugin",
  "publisher": "example",
  "description": "A managed out-of-process Abraxius plugin.",
  "requires": {
    "abraxius": ">=1.0 <2.0",
    "pluginApi": { "major": 1, "minor": 0 },
    "platforms": ["Windows", "Linux", "macOS"],
    "architectures": ["x64", "arm64"]
  },
  "entrypoints": [
    { "tier": "ManagedOutOfProcess", "path": "lib/net10.0/ExamplePlugin.dll", "type": "ExamplePlugin.Plugin" }
  ],
  "permissions": [],
  "contributions": [
    { "id": "hello", "kind": "Command", "displayName": "Hello from plugin", "version": "1", "requiredPermissions": [] }
  ],
  "dependencies": []
}
