{
  "Abraxius": {
    "Scheduler": {
      "DefaultQueueCapacity": 32,
      "DefaultTimeoutSeconds": 30,
      "ConcurrencyLimits": {
        "Model": 4,
        "Tool": 4,
        "Memory": 2
      }
    },
    "Memory": {
      "UseFileEvidence": true
    },
    "Intelligence": {
      "RoutingMode": "FreeFirst",
      "MaximumTier": "Frontier",
      "AllowPaidInference": false,
      "MaximumEscalations": 2,
      "StrictUnknownCost": true,
      "OmniRoute": {
        "Enabled": true,
        "Endpoint": "http://localhost:20128/v1/chat/completions",
        "DefaultModel": "auto/coding:free",
        "ApiKeyEnvironmentVariable": "OMNIROUTE_API_KEY"
      },
      "LiteLlm": {
        "Enabled": false,
        "Endpoint": "http://localhost:4000/v1/chat/completions",
        "DefaultModel": "general-low-cost"
      },
      "Frontier": {
        "Enabled": false
      },
      "Models": [
        {
          "ModelId": "omniroute-free-coding",
          "Provider": "omniroute",
          "Gateway": "OmniRoute",
          "Route": "auto/coding:free",
          "Tier": "Free",
          "CostClass": "Zero",
          "Streaming": true,
          "ToolCalling": true,
          "StructuredOutput": true,
          "Reasoning": true,
          "Coding": true,
          "ContextWindow": 128000,
          "MaximumOutputTokens": 8192
        }
      ]
    },
    "Ui": {
      "PerformanceMode": "Balanced",
      "GraphRefreshRate": 60,
      "ReducedMotion": false
    }
  }
}
